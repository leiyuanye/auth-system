<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.auth.mapper.PhoneDeviceArchiveMapper">

    <resultMap id="archiveMap" type="com.example.auth.entity.PhoneDeviceArchive">
        <result column="id" property="id"/>
        <result column="account_type" property="accountType"/>
        <result column="device_code" property="deviceCode"/>
        <result column="account_index" property="accountIndex"/>
        <result column="phone_no" property="phoneNo"/>
        <result column="wechat_nickname" property="wechatNickname"/>
        <result column="entity_name" property="entityName"/>
        <result column="wechat_person" property="wechatPerson"/>
        <result column="wechat_phone" property="wechatPhone"/>
        <result column="phone_location" property="phoneLocation"/>
        <result column="wechat_status" property="wechatStatus"/>
        <result column="use_status" property="useStatus"/>
        <result column="dept" property="dept"/>
        <result column="wechat_usage" property="wechatUsage"/>
        <result column="wx_status" property="wxStatus"/>
        <result column="wx_usage" property="wxUsage"/>
        <result column="phone_type" property="phoneType"/>
        <result column="wx_realname" property="wxRealname"/>
        <result column="wx_phone" property="wxPhone"/>
        <result column="wx_password" property="wxPassword"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="archive_time" property="archiveTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.auth.entity.PhoneDeviceArchive"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO phone_device_archive (
            account_type, device_code, account_index, phone_no,
            wechat_nickname, entity_name, wechat_person, wechat_phone,
            phone_location, wechat_status, use_status, dept,
            wechat_usage, wx_status, wx_usage, phone_type,
            wx_realname, wx_phone, wx_password, remark,
            create_time, update_time, archive_time
        ) VALUES (
            #{accountType}, #{deviceCode}, #{accountIndex}, #{phoneNo},
            #{wechatNickname}, #{entityName}, #{wechatPerson}, #{wechatPhone},
            #{phoneLocation}, #{wechatStatus}, #{useStatus}, #{dept},
            #{wechatUsage}, #{wxStatus}, #{wxUsage}, #{phoneType},
            #{wxRealname}, #{wxPhone}, #{wxPassword}, #{remark},
            #{createTime}, #{updateTime}, NOW()
        )
    </insert>

    <select id="selectByDeviceCode" resultMap="archiveMap">
        SELECT * FROM phone_device_archive
        WHERE device_code = #{deviceCode}
        ORDER BY archive_time DESC
    </select>

    <select id="countTotal" resultType="int">
        SELECT COUNT(*) FROM phone_device_archive
    </select>

    <select id="countMain" resultType="int">
        SELECT COUNT(*) FROM phone_device_archive WHERE account_type = 'main'
    </select>

    <select id="countSub" resultType="int">
        SELECT COUNT(*) FROM phone_device_archive WHERE account_type = 'sub'
    </select>

</mapper>
