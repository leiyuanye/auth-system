<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.auth.mapper.SysOperateLogMapper">

    <resultMap id="SysOperateLogMap" type="com.example.auth.entity.SysOperateLog">
        <id column="id" property="id"/>
        <result column="module_name" property="moduleName"/>
        <result column="operate_type" property="operateType"/>
        <result column="data_id" property="dataId"/>
        <result column="data_name" property="dataName"/>
        <result column="field_changed" property="fieldChanged"/>
        <result column="old_value" property="oldValue"/>
        <result column="new_value" property="newValue"/>
        <result column="operator" property="operator"/>
        <result column="operate_time" property="operateTime"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <sql id="whereClause">
        <where>
            <if test="useModuleFlag != null and useModuleFlag == 1 and moduleNames != null and moduleNames.size > 0">
                AND module_name IN
                <foreach collection="moduleNames" item="m" open="(" separator="," close=")">#{m}</foreach>
            </if>
            <if test="useTypeFlag != null and useTypeFlag == 1 and operateTypes != null and operateTypes.size > 0">
                AND operate_type IN
                <foreach collection="operateTypes" item="t" open="(" separator="," close=")">#{t}</foreach>
            </if>
            <if test="operator != null and operator != ''">
                AND operator LIKE CONCAT('%', #{operator}, '%')
            </if>
        </where>
    </sql>

    <select id="selectAll" resultMap="SysOperateLogMap">
        SELECT * FROM sys_operate_log ORDER BY operate_time DESC
    </select>

    <select id="selectById" resultMap="SysOperateLogMap">
        SELECT * FROM sys_operate_log WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.example.auth.entity.SysOperateLog" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_operate_log (module_name, operate_type, data_id, data_name, field_changed, old_value, new_value, operator, remark)
        VALUES (#{moduleName}, #{operateType}, #{dataId}, #{dataName}, #{fieldChanged}, #{oldValue}, #{newValue}, #{operator}, #{remark})
    </insert>

    <select id="selectByCondition" resultMap="SysOperateLogMap">
        SELECT * FROM sys_operate_log
        <include refid="whereClause"/>
        ORDER BY operate_time DESC
        <if test="offset != null and limit != null">LIMIT #{offset}, #{limit}</if>
    </select>

    <select id="countByCondition" resultType="int">
        SELECT COUNT(*) FROM sys_operate_log
        <include refid="whereClause"/>
    </select>

    <select id="selectDistinctModules" resultType="string">
        SELECT DISTINCT module_name FROM sys_operate_log
        WHERE module_name IS NOT NULL AND module_name != ''
        ORDER BY module_name
    </select>
</mapper>
